<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- PHA-3072 rebrand: TeamSpeak blue on Discord-style greys, dark only.
         windowBackground matches the Compose `Bg` token so the pre-Compose
         window doesn't flash a different grey on cold start. -->
    <color name="plnt_bg">#1A1B1E</color>
    <color name="plnt_surface">#1A1B1E</color>
    <color name="ts_brand">#4B69B6</color>

    <style name="Theme.Plnt" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/plnt_bg</item>
        <item name="android:statusBarColor">@color/plnt_surface</item>
        <item name="android:navigationBarColor">@color/plnt_bg</item>
    </style>
</resources>
