<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Voice client: PHA-3074 architecture decisions locked the project scope
        to "VOICE ONLY — connect, channel tree, who-is-talking, join channel,
        push-to-talk / open mic, mute/deafen, Bluetooth headsets." These
        permissions cover that surface; chat / streams / file transfer are
        out of scope per the spike write-up.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- For the persistent connection notification's talk-state/mute/disconnect
         actions (PHA-3078); requested from MainActivity so the toggle is granted
         before that notification ever needs to post. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- PHA-3078: VoiceService's ConnectivityManager.NetworkCallback (wifi<->LTE
         handoff detection) and the partial wake lock held while connected. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="true"
        android:label="PLNT"
        android:supportsRtl="true"
        android:theme="@style/Theme.Plnt">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Plnt">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            PHA-3077: owns the AudioEngine + plnt-core Client for the
            lifetime of a call. foregroundServiceType=microphone matches the
            FOREGROUND_SERVICE_MICROPHONE permission above (required on
            API 29+ to keep RECORD_AUDIO alive while backgrounded).
        -->
        <service
            android:name=".service.VoiceService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

    </application>

</manifest>
