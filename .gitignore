# Generated by Cargo
# will have compiled files and executables
debug
target

# Cargo build artifacts inside core/
core/target/
core/Cargo.lock
core/target/

# Android Gradle build outputs
app/.gradle/
app/build/
app/app/build/
app/local.properties
app/app/release/
app/app/debug/
app/app/.cxx/

# Generated UniFFI Kotlin scaffolding lives in source; no extra generated files
# need to be ignored here. The uniffi-bindgen CLI writes to a tracked path
# under app/app/src/main/kotlin/com/plnt/client/plnt/.
# 
# If the team decides to keep generated Kotlin out of git (preferred for
# large generated trees), add:
#   app/app/src/main/kotlin/com/plnt/client/plnt/

# Cross-compiled .so outputs (committed for the toolchain contract)
# Per build.sh, these land in jniLibs/<target>/. They are checked in so
# a downstream user who only has `git clone` can still install app-debug.apk
# without running the full Rust toolchain. Comment out if you'd rather
# regenerate locally each time.
# app/app/src/main/jniLibs/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# Android Studio / IntelliJ
.idea/
*.iml
.kotlin/

# Local environment / Gradle wrapper
.gradle/
*.log
